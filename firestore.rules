rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function validTask(data, taskId) {
      return data.keys().hasOnly(['id', 'ownerId', 'title', 'dueDateTime',
                                  'createdAt', 'priority', 'tag', 'isDone'])
        && data.keys().hasAll(['id', 'ownerId', 'title', 'dueDateTime',
                               'createdAt', 'priority', 'tag', 'isDone'])
        && data.id == taskId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() > 0
        && data.dueDateTime is timestamp
        && data.createdAt is timestamp
        && data.priority in ['low', 'medium', 'high']
        && data.tag in ['school', 'personal', 'others']
        && data.isDone is bool;
    }

    match /tasks/{taskId} {
      allow read: if isOwner();

      allow create: if isSignedIn()
                    && validTask(request.resource.data, taskId);

      allow update: if isOwner()
                    && validTask(request.resource.data, taskId);

      allow delete: if isOwner();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && username.matches('^[a-z0-9_]{3,20}$');
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}