rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------- list helpers ------------------------------------------
    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isListMember(listId) {
      return isSignedIn() && request.auth.uid in listData(listId).memberIds;
    }

    // Personal task: only its owner. Shared task: any member of its list.
    function canAccessTask(data) {
      return isSignedIn() && (
        (data.listId == 'personal' && data.ownerId == request.auth.uid)
        || (data.listId != 'personal' && isListMember(data.listId))
      );
    }

    // Shape check only (who may write is decided in the match block).
    function validTaskShape(data, taskId) {
      return data.keys().hasOnly(['id', 'ownerId', 'listId', 'title',
                                  'dueDateTime', 'createdAt', 'priority',
                                  'tag', 'isDone'])
        && data.keys().hasAll(['id', 'ownerId', 'listId', 'title',
                               'dueDateTime', 'createdAt', 'priority',
                               'tag', 'isDone'])
        && data.id == taskId
        && data.listId is string
        && data.title is string && data.title.size() > 0
        && data.dueDateTime is timestamp
        && data.createdAt is timestamp
        && data.priority in ['low', 'medium', 'high']
        && data.tag in ['school', 'personal', 'others']
        && data.isDone is bool;
    }

    function validListShape(data, listId) {
      return data.keys().hasOnly(['id', 'name', 'ownerId', 'memberIds',
                                  'createdAt'])
        && data.keys().hasAll(['id', 'name', 'ownerId', 'memberIds',
                               'createdAt'])
        && data.id == listId
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 60
        && data.memberIds is list && data.memberIds.size() <= 50
        && data.createdAt is timestamp;
    }

    match /tasks/{taskId} {
      // Read (get and list): personal owner, or member of the task's list.
      allow read: if canAccessTask(resource.data);

      // Create: you are the creator, and you may access the target list.
      allow create: if isSignedIn()
                    && validTaskShape(request.resource.data, taskId)
                    && request.resource.data.ownerId == request.auth.uid
                    && canAccessTask(request.resource.data);

      // Update: you can access it now; creator and list can never change.
      allow update: if canAccessTask(resource.data)
                    && validTaskShape(request.resource.data, taskId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.listId == resource.data.listId;

      // Delete: personal owner, or any member of the task's list.
      allow delete: if canAccessTask(resource.data);
    }

    match /lists/{listId} {
      // Only members can see a list. Non-members get permission-denied.
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberIds;

      // Create: you are the owner and the only member at the start.
      allow create: if isSignedIn()
                    && listId != 'personal'
                    && validListShape(request.resource.data, listId)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid];

      // Update (add members, rename): owner only. Owner cannot change
      // and must stay a member.
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && validListShape(request.resource.data, listId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.auth.uid in request.resource.data.memberIds;

      // Delete: owner only.
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    match /usernames/{username} {
      allow get: if true;
      // Your own lookup, or a single-result lookup (used to add a member
      // by email). Bulk listing of usernames stays blocked.
      allow list: if isSignedIn()
        && (resource.data.uid == request.auth.uid
            || request.query.limit <= 1);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && username.matches('^[a-z0-9_]{3,20}$');
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}